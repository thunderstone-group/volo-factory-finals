+def recover_skipped(text, suite, complete, workers=GROUP_WORKERS):
+    """One requirements-only attempt per file to construct skipped GIVEN states; original live tests stay intact."""
+    suite = Path(suite)
+    manifest = json.loads((suite / "suite.json").read_text(encoding="utf-8"))
+    groups = {g["file"]: g for g in plan(text)}
+    requirements = {r["id"]: r for r in scenarios.load_requirements(text)}
+    node = _node()
+
+    def one(record):
+        name = record["file"]
+        if record.get("syntax") or name not in groups or record.get("recovery") or not (suite / name).is_file():
+            return
+        path = suite / name
+        original = path.read_text(encoding="utf-8")
+        skipped = _skipped_declarations(original)
+        if not skipped:
+            return
+        info = {"skipped_before": sorted(skipped), "claims": [], "calls": 0}
+        record["recovery"] = info
+        messages = request(text, groups[name], manifest.get("prerequisites") or "")
+        messages += [{"role": "assistant", "content": f"=== FILE: {name} ===\n{original.rstrip()}\n=== END ==="},
+                     {"role": "user", "content": RECOVER}]
+        for attempt in range(2):
+            try:
+                info["calls"] += 1
+                content, _, finish = complete(messages)
+            except Exception as exc:
+                info["error"] = f"{type(exc).__name__}: {str(exc)[:300]}"
+                break
+            try:
+                if finish != "stop":
+                    raise ValueError(f"recovery response is incomplete ({finish})")
+                fixed, claims = _recover_reply(content, original, requirements, node, path)
+                if claims:
+                    path.write_text(fixed, encoding="utf-8")
+                info["claims"] = claims
+                info.pop("error", None)
+                break
+            except (ValueError, TypeError, KeyError) as exc:
+                info["error"] = str(exc)[:500]
+                if attempt == 0:
+                    info["rejected_first_reply"] = str(exc)[:500]
+                    messages += [{"role": "assistant", "content": content}, {"role": "user", "content":
+                        "The recovery could not be validated: " + str(exc)[:800] +
+                        ". Correct the same two blocks from the public requirements, preserving the original runnable tests. "
+                        "Do not add controls or behavior outside those requirements. If the original GIVEN cannot be "
+                        "constructed through documented flows, leave that scenario unrecovered."}]
+            except OSError as exc:
+                info["error"] = f"{type(exc).__name__}: {str(exc)[:300]}"
+                break
+
+    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, workers)) as pool:
+        list(pool.map(one, manifest["files"]))
+    manifest["recovered_scenarios"] = sum(len(r.get("recovery", {}).get("claims", [])) for r in manifest["files"])
+    (suite / "suite.json").write_text(json.dumps(manifest, indent=1, ensure_ascii=False) + "\n", encoding="utf-8")
+    return manifest
+
