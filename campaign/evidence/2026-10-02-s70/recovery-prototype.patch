+class RecoveryCase(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.suite = Path(self.temp.name)
+        self.path = self.suite / testgen.plan(REQUIREMENTS)[0]["file"]
+        self.live = "test('REQ-1-1: Add one', async () => { expect(1).toBe(1); });"
+        self.skip = "test.skip('REQ-1-2: Edit one', () => { /* no initial record */ });"
+        self.original = "const { test, expect } = require('@playwright/test');\n" + self.live + "\n" + self.skip + "\n"
+        self.path.write_text(self.original)
+        (self.suite / 'suite.json').write_text(json.dumps({"files": [{"file": self.path.name,
+            "tests": ['REQ-1-1: Add one', 'REQ-1-2: Edit one']}], "scenarios": 2, "tests": 2}))
+        self.claim = {"id": "REQ-1-2", "reason": "Create a note before opening its editor.",
+                      "setup": [{"requirement": "REQ-1-1", "quote": 'The home page has a button named “Add note”'}]}
+        self.replacement = ("test('REQ-1-2: Edit one', async ({page}) => { "
+                            "await page.getByRole('button', {name:'Add note'}).click(); "
+                            "await expect(page.getByRole('textbox')).toBeVisible(); });")
+
+    def complete(self, messages):
+        self.assertTrue(any(self.original.rstrip() in m['content'] for m in messages if m['role'] == 'assistant'))
+        return ("=== FILE: recovery.json ===\n" + json.dumps([self.claim]) + "\n=== END ===\n"
+                "=== FILE: replacements.cjs ===\n" + self.replacement + "\n=== END ==="), {}, 'stop'
+
+    def test_recovers_only_skipped_body_and_preserves_live_tests_and_helpers(self):
+        result = testgen.recover_skipped(REQUIREMENTS, self.suite, self.complete)
