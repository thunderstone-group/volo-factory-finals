+def _undeclared_recovery_controls(body, requirements):
+    """Catch invented literal interaction names before they can become product-repair targets."""
+    names = [m.group(2) for m in re.finditer(r"\.getBy(?:Label|Placeholder)\(\s*(['\"`])((?:\\.|(?!\1).)*)\1", body)]
+    role = re.compile(r"\.getByRole\(\s*(['\"])([\w-]+)\1\s*,\s*\{[^{}]*?\bname\s*:\s*(['\"`])((?:\\.|(?!\3).)*)\3")
+    names += [m.group(4) for m in role.finditer(body)
+              if m.group(2) in {"button", "link", "menuitem", "textbox", "searchbox", "combobox", "checkbox", "radio", "option"}]
+    quoted = _phrases(requirements)
+    return sorted({name for name in names if "${" not in name and ungrounded(name, body, requirements, quoted)})
+
