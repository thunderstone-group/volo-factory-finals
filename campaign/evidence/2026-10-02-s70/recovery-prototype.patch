+RECOVER = """Review only the skipped scenarios in this file. The application is not available to you.
+For each skipped GIVEN state, search the requirements' dependency and creation flows before declaring it
+unconstructable. Compose actor creation, membership, authorization, resource creation/copying, and the required
+state transitions where the text provides them. Missing credentials for an unnamed seeded actor do not by
+themselves prevent registering a fresh actor with known compliant credentials and granting the required role.
+Likewise a linked resource can sometimes be created from an existing revision without changing the seed itself.
+Use only documented UI flows, roles and names. Do not invent seed credentials, API routes, database writes or
+browser-storage mutations. Do not weaken a GIVEN condition or replace a named required identity with another one.
+Creating a blank container does not reproduce the contents or relationships of a seeded container. If the needed
+state exists only in seed records, reuse its documented creation/copy flows; do not invent editing features the
+real-world product normally has. Reopen each flow from its documented entry, not an assumed link on the last page.
+For an unauthorized actor, navigation links may legitimately be absent. Follow only permitted navigation or a
+page address observed through authorized UI, then check the stated denial; never require an optional entry link.
+When a heading must contain a data value, check containment rather than imposing an exact whole heading.
+Construct fresh mutable records where possible, leave shared seed credentials and records usable by later tests,
+and keep the scenario's stated authorization and state effects. An unavailable required UI operation is a failing
+product check, not a reason to conditionally skip the test.
+
+Recover only scenarios you can justify. Keep all existing helpers and non-skipped tests exactly as they are.
+Return two blocks. recovery.json is an array with one entry per recovered scenario:
+[{"id":"<original scenario id>","setup":[{"requirement":"<requirement id establishing a needed flow>"}],
+"reason":"<how those public flows establish the original GIVEN state>"}]
+Every setup step cites a real requirement id, including prerequisite requirements in other groups. The caller
+attaches its authoritative description from the original input; do not retype or paraphrase it as a quotation.
+replacements.cjs contains ONLY standalone test(title, async (...) => {...}) declarations replacing those skipped
+tests, with the SAME ids and titles. Each must assert the required effect. Reuse existing helpers or define local
+functions inside the test callback. Do not add imports, suite hooks, test.skip/only/fixme or timeout overrides.
+If a state truly cannot be built using the documented UI, omit that scenario from both blocks. Empty is allowed.
+=== FILE: recovery.json ===
+<array>
+=== END ===
+=== FILE: replacements.cjs ===
+<replacement declarations>
+=== END ==="""
+
+
+def _skipped_declarations(body):
+    """Literal skipped declarations with inline callbacks; never rewrite unrelated source."""
+    found = {}
+    for match in TITLE.finditer(body):
+        if not body[match.start():match.end()].startswith("test.skip("):
+            continue
+        head = re.match(r"\s*,\s*(?:async\s+)?\([^)]*\)\s*=>\s*(\{)", body[match.end():])
+        if not head:
+            continue
+        close = _block_end(body, match.end() + head.end() - 1)
+        tail = re.match(r"\s*\)\s*;?", body[close + 1:]) if close >= 0 else None
+        if tail:
+            sid = _test_id(match.group(2))[0]
+            found[sid] = {"start": match.start(), "end": close + 1 + tail.end(), "title": match.group(2)}
+    return found
+
+
+def _recover_reply(content, original, requirements, node, path):
+    parts = {m.group(1).strip(): m.group(2) for m in FILE_BLOCK.finditer(content or "")}
+    if set(parts) != {"recovery.json", "replacements.cjs"}:
+        raise ValueError("recovery must return recovery.json and replacements.cjs")
+    claims = json.loads(parts["recovery.json"])
+    if not isinstance(claims, list):
+        raise ValueError("recovery claims must be a list")
+    body = unfence(parts["replacements.cjs"]).strip()
+    if SKIPPING.search(body) or re.search(r"\btest\.(?:before|after|describe|use|setTimeout)|\brequire\s*\(", body):
+        raise ValueError("recovery must preserve suite configuration and run every replacement")
+    if re.search(r"\b(?:localStorage|sessionStorage|indexedDB|fetch)\b|\.request\s*[.(]|\b(?:ARC|APP)\.state", body):
+        raise ValueError("recovery must construct state through the documented UI")
+    text = "\n".join(str(r.get("description") or "") + "\n" + json.dumps(r.get("scenarios") or [], ensure_ascii=False)
+                     for r in requirements.values())
+    undeclared = _undeclared_recovery_controls(body, text)
+    if undeclared:
+        raise ValueError("recovery uses undeclared UI names: " + ", ".join(undeclared))
+    blocks = _audit_test_blocks(body)
+    titles = {_test_id(m.group(2))[0]: m.group(2) for m in TITLE.finditer(body)}
+    skipped = _skipped_declarations(original)
+    claims = [dict(c, id=c['id'][:-2], reported_id=c['id'])
+              if isinstance(c, dict) and isinstance(c.get('id'), str) and c['id'].endswith('#1')
+              and c['id'][:-2] in skipped else c for c in claims]
+    ids = [c.get("id") for c in claims if isinstance(c, dict)]
+    if len(ids) != len(claims) or len(set(ids)) != len(ids) or set(ids) != set(blocks) or not set(ids) <= set(skipped):
+        raise ValueError("recovery ids must match only the original skipped scenarios")
+    helpers = _audit_assertion_helpers(original)
+    for claim in claims:
+        sid = claim["id"]
+        if titles[sid] != skipped[sid]["title"]:
+            raise ValueError("recovery must retain the original scenario title")
+        if (not isinstance(claim.get("reason"), str) or not claim["reason"].strip()
+                or not isinstance(claim.get("setup"), list) or not claim["setup"]):
+            raise ValueError("recovery needs a justified setup plan")
+        for step in claim["setup"]:
+            if not isinstance(step, dict):
+                raise ValueError("recovery setup steps must cite requirement descriptions")
+            rid = step.get("requirement")
+            if not isinstance(rid, str) or rid not in requirements or not requirements[rid].get("description"):
+                raise ValueError("recovery setup must cite an existing requirement description")
+        # Source text is copied from the input, never accepted from a model's retelling. This binds provenance,
+        # not semantic correctness; the real UI workflow still needs execution and review.
+        claim["source_descriptions"] = [
+            {"requirement": step["requirement"], "description": requirements[step["requirement"]]["description"]}
+            for step in claim["setup"]]
+        if not _audit_has_assertion(blocks[sid], helpers):
+            raise ValueError("recovery needs an observable assertion")
+    fixed = original
+    for sid in sorted(ids, key=lambda sid: skipped[sid]["start"], reverse=True):
+        span = skipped[sid]
+        fixed = fixed[:span["start"]] + blocks[sid] + fixed[span["end"]:]
+    if node and not _parses(node, path, fixed):
+        raise ValueError("recovered tests do not parse with the existing helpers")
+    return fixed, claims
+
