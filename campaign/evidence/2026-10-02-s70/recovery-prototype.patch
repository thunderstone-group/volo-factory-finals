+        self.assertEqual(self.path.read_text(), self.original.replace(self.skip, self.replacement))
+        testgen.recover_skipped(REQUIREMENTS, self.suite, lambda _: self.fail('repeated recovery'))
+
+    def test_invalid_provenance_live_test_replacement_and_state_injection_keep_original(self):
+        original_claim, original_replacement = dict(self.claim), self.replacement
+        cases = [
