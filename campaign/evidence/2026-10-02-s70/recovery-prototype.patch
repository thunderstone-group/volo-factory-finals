+            (dict(self.claim, id='REQ-1-1'), self.replacement.replace('REQ-1-2: Edit one', 'REQ-1-1: Add one')),
+            (self.claim, self.replacement.replace("await page.getByRole", "localStorage.clear(); await page.getByRole")),
+        ]
+        for claim, replacement in cases:
+            with self.subTest(replacement=replacement):
+                (self.suite / 'suite.json').write_text(json.dumps({'files': [{'file': self.path.name}], 'tests': 2}))
+                self.claim, self.replacement = claim, replacement
