ar { width: 200px; flex: none; order: -1; }\\n.sidebar button, .sidebar a { display: block; width: 100%; text-align: left; margin: 0 0 8px; background: none; border: 0; padding: 6px 8px; border-radius: 6px; }\\n.sidebar [aria-current=\\"page\\"] { background: #ddf4ff; }\\n.main { flex: 1; min-width: 0; }\\n.app-footer { padding: 12px 16px; border-top: 1px solid #d0d7de; color: #57606a; font-size: 13px; }\\n.row { padding: 10px; border: 1px solid #d0d7de; border-radius: 6px; margin-bottom: 8px; }\\n.row-actions { display: none; gap: 8px; margin-top: 8px; }\\n.row:hover .row-actions, .row:focus-within .row-actions { display: flex; }\\n#dialog-root[hidden], #status-root[hidden] { display: none; }\\n#dialog-root { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,.35); }\\n.dialog { background: #fff; padding: 16px; border-radius: 8px; min-width: 320px; max-width: 90vw; max-height: 90vh; overflow: auto; }\\n#status-root { position: fixed; left: 16px; bottom: 16px; }\\n.status { background: #1f2328; color: #fff; padding: 10px 14px; border-radius: 6px; display: flex; gap: 12px; align-items: center; }\\nform label { display: block; margin: 8px 0 4px; }\\ninput, textarea, select { font: inherit; padding: 6px 8px; width: 100%; max-width: 480px; }\\n.app-header .brand-logo { display: inline-flex; align-items: center; background: none; border: 0; padding: 0 6px 0 0; color: inherit; cursor: pointer; }\\n.popover { position: relative; z-index: 5; display: flex; flex-wrap: wrap; gap: 4px; padding: 6px; margin-top: 4px; background: #fff; border: 1px solid #ddd; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,.12); }\\n.popover button { display: inline-block; }\\n.combobox { position: relative; display: inline-block; }\\n.combobox [role=\\"combobox\\"] { min-width: 120px; text-align: left; }\\n.listbox { position: absolute; z-index: 6; left: 0; top: 100%; min-width: 100%; background: #fff; border: 1px solid #ddd; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,.12); padding: 4px 0; }\\n.listbox [role=\\"option\\"] { padding: 4px 10px; cursor: pointer; white-space: nowrap; }\\n.listbox [role=\\"option\\"]:hover, .listbox [role=\\"option\\"][aria-selected=\\"true\\"] { background: #eef; }\\n"}]'

